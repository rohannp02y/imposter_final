rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // User profiles. isAdmin is only ever set from the backend/console —
    // clients (even the owner) cannot write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Word packs: public read (the game loads them), admin-only writes.
    match /packs/{packId} {
      allow read: if true;
      allow write: if isAdmin();

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Anonymous game-start logs for the admin dashboard.
    match /gameLogs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['playerCount', 'imposterCount', 'categories', 'hintWord', 'hintCategory', 'createdAt'])
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount >= 3
        && request.resource.data.playerCount <= 10
        && request.resource.data.imposterCount is int
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 30;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
